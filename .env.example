# ========= Ertiqaa ERP - local configuration =========
# Copy this file to .env and fill in your values.
#   Windows (PowerShell):  copy .env.example .env
#   Windows (cmd):         copy .env.example .env

# ---------- MariaDB / MySQL connection ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mariadb-password
DB_NAME=ertiqaa_erp

# ---------- security (generate your own long random strings) ----------
# JWT session signing secret
JWT_SECRET=change-me-to-a-long-random-string
# Used to encrypt document files AND signed download links.
# WARNING: if you change ENCRYPTION_KEY after starting to use the app,
# previously stored documents and saved join links stop working.
ENCRYPTION_KEY=change-me-to-a-different-long-random-string

# ---------- server ----------
PORT=3000
# How long a signed document-download link stays valid (seconds)
LINK_TTL_SECONDS=300

# ---------- first-run seeding ----------
# base = reference data + one administrator account (recommended for real use)
# demo = fictional demo company data (12 users, 69 cases, 414 documents)
# none = do nothing
SEED_MODE=base
# Used only the first time, for the base-mode administrator account:
ADMIN_EMAIL=admin@ertiqaa.ae
ADMIN_PASSWORD=change-me-before-first-start

# ---------- website form webhook (optional) ----------
# Point the ertiqaa.ae contact form at POST http://localhost:3000/api/webhook/enquiry
# with header  X-Webhook-Secret: <same value as here>. Leave empty to disable the webhook.
WEBHOOK_SECRET=
